+++ b/vllm/v1/core/hybrid_checkpoint/frontier.py
@@ -0,0 +1,416 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Frontier checkpoints: a finished request's state at its exact end.
+
+For a freed request that processed `L` tokens, `L` inside block `k`, a
+frontier checkpoint is the attention page holding `[kB, L)` in every
+full-attention group, the running state block in every Mamba group and, when
+`L` is inside an indexer compression pool, the indexer's ring block. Each
+block is cached under `(key, group)` with the frontier key of `L`
+(`keys.frontier_key`). A later request whose tokens extend those `L`
+tokens resumes at `L`: upstream's partial-hit copy-on-write gives it private
+copies of the page and the state, and the ring is copied when it is claimed.
+The checkpoint is usable only while every one of its blocks is cached; when
+any of them is evicted the others lose the key too.
+"""
+
+import math
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from vllm.utils.math_utils import cdiv
+from vllm.v1.core.hybrid_checkpoint.keys import frontier_key
+from vllm.v1.core.kv_cache_utils import (
+    BlockHash,
+    BlockHashWithGroupId,
+    KVCacheBlock,
+    get_block_hash,
+    make_block_hash_with_group_id,
+)
+from vllm.v1.core.single_type_kv_cache_manager import CircularBufferManager
+from vllm.v1.core.hybrid_checkpoint._compat import CircularBufferSpec
+from vllm.v1.request import RequestStatus
+
+if TYPE_CHECKING:
+    from vllm.v1.core.kv_cache_coordinator import KVCacheCoordinator
+    from vllm.v1.request import Request
+
+# Tokens before the frontier compared ahead of the key, so that a lookup
+# hashes only candidates that already end like the request.
+_SUFFIX = 8
+
+HitBlocks = tuple[list[KVCacheBlock], ...]
+
+
+@dataclass(slots=True)
+class _Frontier:
+    key: BlockHash
+    anchor: BlockHash | None
+    num_tokens: int
+    suffix: tuple[int, ...]
+    # Group id -> the block cached under (key, group).
+    blocks: dict[int, KVCacheBlock]
+
+
+@dataclass(slots=True)
+class _Lookup:
+    hit: int
+    num_tokens: int
+    key: BlockHash | None
+    # Live frontiers equal to the request's tokens but for their last token.
+    stale: tuple[BlockHash, ...]
+
+
+class FrontierIndex:
+    def __init__(
+        self,
+        coordinator: "KVCacheCoordinator",
+        hash_fn: Callable[[Any], bytes],
+        pages: list[int],
+        states: list[int],
+        rings: list[int],
+    ) -> None:
+        self.pool = coordinator.block_pool
+        self.managers = coordinator.single_type_managers
+        self.block_size = coordinator.scheduler_block_size
+        self.hash_block_size = self.pool.hash_block_size
+        self.hash_fn = hash_fn
+        self.pages = pages
+        self.states = states
+        self.rings = rings
+        group_sizes = []
+        for group_id in rings:
+            ring = self.managers[group_id]
+            assert isinstance(ring, CircularBufferManager)
+            assert isinstance(ring.kv_cache_spec, CircularBufferSpec)
+            ring.takes_frontier_hits = True
+            group_sizes.append(ring.kv_cache_spec.group_size)
+        # A frontier inside this many tokens' pool also keeps the ring.
+        self.pool_size = math.lcm(1, *group_sizes)
+        # Free blocks that lose their keys go to the front of the free queue.
+        self.reclaim = False
+        self.entries: dict[BlockHash, _Frontier] = {}
+        # anchor -> num_tokens -> suffix -> keys
+        self._index: dict[
+            BlockHash | None, dict[int, dict[tuple[int, ...], list[BlockHash]]]
+        ] = {}
+        self._lookups: dict[str, _Lookup] = {}
+        # Admitted request -> stale frontiers its lookup found, which its
+        # finish may release.
+        self.superseded: dict[str, tuple[BlockHash, ...]] = {}
+        self.num_published = 0
+        self.num_hits = 0
+        self.num_hit_tokens = 0
+        self.num_removed = 0
+
+    def publish(self, request: "Request") -> BlockHash | None:
+        """Cache the freed request's state at its processed frontier in every
+        group, or in none. Returns the key."""
+        self._lookups.pop(request.request_id, None)
+        num_tokens = request.num_computed_tokens
+        if (
+            num_tokens == 0
+            or num_tokens % self.block_size == 0
+            or request.resumable
+            or request.status == RequestStatus.FINISHED_ABORTED
+            # An input token of a dispatched step is not known yet.
+            or request.num_tokens < num_tokens
+        ):
+            return None
+        blocks = self._frontier_blocks(request, num_tokens)
+        if blocks is None:
+            return None
+        key = frontier_key(self.hash_fn, request, num_tokens, self.hash_block_size)
+        if key in self.entries:
+            return None
+        h = num_tokens // self.hash_block_size
+        anchor = request.block_hashes[h - 1] if h else None
+        for group_id, block in blocks.items():
+            self.pool.cache_block_under_key(
+                block, make_block_hash_with_group_id(key, group_id), num_tokens
+            )
+        start = max(h * self.hash_block_size, num_tokens - _SUFFIX)
+        suffix = tuple(request.all_token_ids[start:num_tokens])
+        self.entries[key] = _Frontier(key, anchor, num_tokens, suffix, blocks)
+        by_length = self._index.setdefault(anchor, {}).setdefault(num_tokens, {})
+        by_length.setdefault(suffix, []).append(key)
+        self.num_published += 1
+        return key
+
+    def _frontier_blocks(
+        self, request: "Request", num_tokens: int
+    ) -> dict[int, KVCacheBlock] | None:
+        """The block to cache in every group."""
+        request_id = request.request_id
+        k = num_tokens // self.block_size
+        blocks: dict[int, KVCacheBlock] = {}
+        for group_id in self.pages:
+            table = self.managers[group_id].req_to_blocks.get(request_id) or []
+            if len(table) <= k:
+                return None
+            blocks[group_id] = table[k]
+        running = cdiv(num_tokens, self.block_size) - 1
+        for group_id in self.states:
+            table = self.managers[group_id].req_to_blocks.get(request_id) or []
+            # Align mode keeps the running state in the last block.
+            if len(table) != running + 1:
+                return None
+            blocks[group_id] = table[running]
+        if num_tokens % self.pool_size:
+            for group_id in self.rings:
+                table = self.managers[group_id].req_to_blocks.get(request_id) or []
+                if len(table) != 1:
+                    return None
+                blocks[group_id] = table[0]
+        keyed = self.pool.cached_block_hashes_by_block
+        units_per_block = self.block_size // self.hash_block_size
+        for group_id, block in blocks.items():
+            if block.is_null:
+                return None
+            # With a hash unit finer than the block, the page may already be
+            # cached under the request's own key at a hash-unit boundary inside
+            # it; the frontier key joins that key.
+            if (block.block_hash is not None or block.block_id in keyed) and (
+                group_id not in self.pages or units_per_block == 1
+            ):
+                return None
+        return blocks
+
+    def extend(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+    ) -> tuple[HitBlocks, int]:
+        """`(blocks, hit)` resumed at the longest frontier past `hit` that
+        `request`'s tokens extend, or the arguments unchanged."""
+        stale: list[BlockHash] = []
+        found = self._lookup(request, blocks, hit, max_length, stale=stale)
+        if found is None:
+            self._lookups[request.request_id] = _Lookup(hit, 0, None, tuple(stale))
+            return blocks, hit
+        entry, k, pages = found
+        self._lookups[request.request_id] = _Lookup(
+            hit, entry.num_tokens, entry.key, tuple(stale)
+        )
+        return self._hit_blocks(blocks, pages, entry, k), entry.num_tokens
+
+    def peek_blocks(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+    ) -> tuple[HitBlocks, int]:
+        """What `extend` would return, recording and removing nothing."""
+        found = self._lookup(request, blocks, hit, max_length, stale=None)
+        if found is None:
+            return blocks, hit
+        entry, k, pages = found
+        return self._hit_blocks(blocks, pages, entry, k), entry.num_tokens
+
+    def resumed_at(self, request_id: str, num_computed_tokens: int) -> BlockHash | None:
+        """The frontier the request's latest lookup resumes it at, when it is
+        admitted at that frontier's length."""
+        lookup = self._lookups.get(request_id)
+        if lookup is None or lookup.num_tokens != num_computed_tokens:
+            return None
+        return lookup.key
+
+    def _lookup(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+        *,
+        stale: list[BlockHash] | None,
+    ) -> tuple[_Frontier, int, dict[int, list[KVCacheBlock]]] | None:
+        """`stale` (None for a read-only lookup) collects the live frontiers
+        found equal to the request's tokens but for their last token."""
+        unit = self.hash_block_size
+        tokens = request.all_token_ids
+        for h in range(max_length // unit, hit // unit - 1, -1):
+            anchor = request.block_hashes[h - 1] if h else None
+            lengths = self._index.get(anchor)
+            if not lengths:
+                continue
+            for num_tokens in sorted(lengths, reverse=True):
+                if num_tokens > max_length:
+                    continue
+                if num_tokens <= hit:
+                    break
+                start = max(h * unit, num_tokens - _SUFFIX)
+                suffix = tuple(tokens[start:num_tokens])
+                keys = lengths[num_tokens].get(suffix, ())
+                if not keys:
+                    if stale is not None:
+                        last = self._mismatch_last(
+                            request, num_tokens, suffix, lengths[num_tokens]
+                        )
+                        if last is not None:
+                            stale.append(last)
+                    continue
+                expected = frontier_key(self.hash_fn, request, num_tokens, unit)
+                if expected not in keys:
+                    continue
+                entry = self.entries[expected]
+                if not self._still_cached(entry):
+                    if stale is not None:
+                        self._remove(entry)
+                    continue
+                k = num_tokens // self.block_size
+                pages = self._prefix_pages(request, blocks, hit, k)
+                if pages is None:
+                    continue
+                return entry, k, pages
+        return None
+
+    def _mismatch_last(
+        self,
+        request: "Request",
+        num_tokens: int,
+        suffix: tuple[int, ...],
+        by_suffix: dict[tuple[int, ...], list[BlockHash]],
+    ) -> BlockHash | None:
+        """The frontier of `num_tokens` tokens equal to the request's first
+        `num_tokens` tokens with only the last one different (an async stop
+        token the client replaced, say)."""
+        for other, keys in by_suffix.items():
+            if other[:-1] != suffix[:-1] or other[-1] == suffix[-1]:
+                continue
+            key = frontier_key(
+                self.hash_fn, request, num_tokens, self.hash_block_size, other[-1]
+            )
+            if key in keys:
+                return key
+        return None
+
+    def _still_cached(self, entry: _Frontier) -> bool:
+        cached = self.pool.cached_block_hash_to_block
+        return all(
+            cached.contain(make_block_hash_with_group_id(entry.key, g), b.block_id)
+            for g, b in entry.blocks.items()
+        )
+
+    def _prefix_pages(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        k: int,
+    ) -> dict[int, list[KVCacheBlock]] | None:
+        """Full-attention blocks `[0, k)`: the block-aligned hit's, then the
+        blocks cached under the request's own block hashes."""
+        num_hit_blocks = hit // self.block_size
+        pages = {g: list(blocks[g][:num_hit_blocks]) for g in self.pages}
+        per_block = self.block_size // self.hash_block_size
+        for i in range(num_hit_blocks, k):
+            found = self.pool.get_cached_block(
+                request.block_hashes[(i + 1) * per_block - 1], self.pages
+            )
+            if found is None:
+                return None
+            for group_id, block in zip(self.pages, found):
+                pages[group_id].append(block)
+        return pages
+
+    def _hit_blocks(
+        self,
+        blocks: HitBlocks,
+        pages: dict[int, list[KVCacheBlock]],
+        entry: _Frontier,
+        k: int,
+    ) -> HitBlocks:
+        hit = list(blocks)
+        for group_id in self.pages:
+            hit[group_id] = pages[group_id] + [entry.blocks[group_id]]
+        for group_id in self.states:
+            hit[group_id] = [self.pool.null_block] * k + [entry.blocks[group_id]]
+        for group_id in self.rings:
+            hit[group_id] = [entry.blocks[group_id]] if group_id in entry.blocks else []
+        return tuple(hit)
+
+    def hit_tokens(self, request_id: str, num_hits: int) -> int:
+        """The tokens past the block-aligned hit that a frontier serves the
+        request if it is admitted `num_hits` tokens in, else 0."""
+        lookup = self._lookups.get(request_id)
+        if lookup is None or lookup.key is None or num_hits != lookup.num_tokens:
+            return 0
+        return lookup.num_tokens - lookup.hit
+
+    def admitted(self, request: "Request", num_hits: int) -> None:
+        """The request was admitted `num_hits` tokens in."""
+        hit_tokens = self.hit_tokens(request.request_id, num_hits)
+        lookup = self._lookups.pop(request.request_id, None)
+        if lookup is None:
+            return
+        if lookup.stale:
+            self.superseded[request.request_id] = lookup.stale
+        else:
+            self.superseded.pop(request.request_id, None)
+        if hit_tokens:
+            self.num_hits += 1
+            self.num_hit_tokens += hit_tokens
+
+    def removed(self, keys: list[BlockHashWithGroupId]) -> None:
+        """A frontier missing any block cannot be hit; its other blocks lose
+        the key too."""
+        for grouped in keys:
+            entry = self.entries.get(get_block_hash(grouped))
+            if entry is not None:
+                self._remove(entry)
+
+    def drop(self, key: BlockHash) -> bool:
+        """Drop the frontier `key` in every group. False if it is none."""
+        entry = self.entries.get(key)
+        if entry is None:
+            return False
+        self._remove(entry)
+        return True
+
+    def _remove(self, entry: _Frontier) -> None:
+        del self.entries[entry.key]
+        lengths = self._index[entry.anchor]
+        suffixes = lengths[entry.num_tokens]
+        keys = suffixes[entry.suffix]
+        keys.remove(entry.key)
+        if not keys:
+            del suffixes[entry.suffix]
+            if not suffixes:
+                del lengths[entry.num_tokens]
+                if not lengths:
+                    del self._index[entry.anchor]
+        cached = self.pool.cached_block_hash_to_block
+        for group_id, block in entry.blocks.items():
+            key = make_block_hash_with_group_id(entry.key, group_id)
+            if not cached.contain(key, block.block_id):
+                continue
+            if block.block_hash != key:
+                # A page that stays cached under the request's own key.
+                self.pool.uncache_key(block, key)
+            else:
+                self.pool._maybe_evict_cached_block(block)
+                self.to_front(block)
+        self.num_removed += 1
+
+    def to_front(self, block: KVCacheBlock) -> None:
+        """With `reclaim`: a free block that just lost its keys is reused
+        before any cached block."""
+        if not self.reclaim or block.ref_cnt or block.prev_free_block is None:
+            return
+        queue = self.pool.free_block_queue
+        queue.remove(block)
+        queue.prepend_n([block])
+
+    def forget(self, request_id: str) -> None:
+        """The request finished: its lookup goes."""
+        self._lookups.pop(request_id, None)
+
+    def reset(self) -> None:
+        self.entries.clear()
+        self._index.clear()
+        self._lookups.clear()
+        self.superseded.clear()
diff --git a/vllm/v1/core/hybrid_checkpoint/keys.py b/vllm/v1/core/hybrid_checkpoint/keys.py
new file mode 100644
index 0000000000..f47b5aff3d
--- /dev/null
+++ b/vllm/v1/core/hybrid_checkpoint/keys.py
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Prefix-cache keys of frontier checkpoints."""
+
+from collections.abc import Callable
+from typing import TYPE_CHECKING, Any
+
+from vllm.multimodal.utils import get_mm_features_in_window
+from vllm.v1.core.kv_cache_utils import (
+    BlockHash,
+    generate_block_hash_extra_keys,
+    hash_block_tokens,
+)
+
+if TYPE_CHECKING:
+    from vllm.v1.request import Request
+
+# Separates frontier keys from block hashes of the same prefix.
+FRONTIER_KEY_MARKER = "mamba-frontier-checkpoint"
+
+
+def frontier_key(
+    hash_fn: Callable[[Any], bytes],
+    request: "Request",
+    num_tokens: int,
+    hash_block_size: int,
+    last_token: int | None = None,
+) -> BlockHash:
+    """Key of the state after `request`'s first `num_tokens` tokens, or
+    after those tokens with the last one replaced by `last_token`.
+
+    It chains the request's block hash at `h * hash_block_size` (`h =
+    num_tokens // hash_block_size`) with the tokens after it, their extra
+    keys (multimodal inputs, LoRA, cache salt) and `num_tokens`, so equal
+    keys mean equal prefixes and lengths.
+    """
+    h = num_tokens // hash_block_size
+    start = h * hash_block_size
+    parent = request.block_hashes[h - 1] if h else None
+    extra = _extra_keys(request, start, num_tokens)
+    tokens = list(request.all_token_ids[start:num_tokens])
+    if last_token is not None:
+        tokens[-1] = last_token
+    return hash_block_tokens(
+        hash_fn,
+        parent,
+        tokens,
+        (*(extra or ()), (FRONTIER_KEY_MARKER, num_tokens)),
+    )
+
+
+def _extra_keys(request: "Request", start: int, end: int) -> tuple[Any, ...] | None:
+    """Prefix-cache extra keys (multimodal inputs, LoRA, cache salt) of
+    tokens `[start, end)`."""
+    mm_idx = 0
+    mm_features = request.mm_features
+    if start > 0 and mm_features:
+        last = mm_features[-1].mm_position
+        if last.offset + last.length > start:
+            mm_idx, _ = get_mm_features_in_window(mm_features, start, end)
+    extra, _ = generate_block_hash_extra_keys(request, start, end, mm_idx)
+    return extra
diff --git a/vllm/v1/core/hybrid_checkpoint/manager.py b/vllm/v1/core/hybrid_checkpoint/manager.py
new file mode 100644
index 0000000000..7b23a3764f
--- /dev/null
+++ b/vllm/v1/core/hybrid_checkpoint/manager.py
@@ -0,0 +1,581 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Resumable recurrent-state checkpoints for hybrid prefix caching.
+
+`HybridCheckpointManager` is what the scheduler and the KV cache manager
+call. It keeps three kinds of recovery units resumable:
+
+- block-boundary states that align mode caches itself (the prompt's replay
+  boundary and shared-prefix junctions under retention interval 0);
+- a decode-boundary state per finished request: a scratch block holds the
+  running state at the last block boundary the output crossed, published
+  when the request finishes;
+- a frontier per finished request (`frontier.FrontierIndex`), at its exact
+  end inside a block.
+
+A request's finish also releases the session leaf it resumed from, unless
+another continuation needs it (`_replace_leaf`). With GreedyDual-Size
+eviction (`eviction.GreedyDualSizeEviction`), block-boundary states are
+never released this way; the eviction order decides when they go.
+"""
+
+import math
+from collections.abc import Callable, Iterable
+from typing import TYPE_CHECKING, Any
+
+from vllm.v1.core.hybrid_checkpoint.cost import PrefillCostModel
+from vllm.v1.core.hybrid_checkpoint.eviction import GreedyDualSizeEviction
+from vllm.v1.core.hybrid_checkpoint.frontier import FrontierIndex, HitBlocks
+from vllm.v1.core.hybrid_checkpoint.units import CheckpointGraph
+from vllm.v1.core.kv_cache_utils import (
+    BlockHash,
+    BlockHashWithGroupId,
+    KVCacheBlock,
+    get_block_hash,
+    get_group_id,
+    make_block_hash_with_group_id,
+)
+from vllm.v1.core.hybrid_checkpoint._compat import CircularBufferSpec
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+    from vllm.v1.core.kv_cache_coordinator import KVCacheCoordinator
+    from vllm.v1.core.kv_cache_manager import KVCacheBlocks
+    from vllm.v1.core.single_type_kv_cache_manager import MambaManager
+    from vllm.v1.request import Request
+
+
+def layout_groups(
+    coordinator: "KVCacheCoordinator",
+) -> tuple[list[int], list[int], list[int]]:
+    """Full-attention, Mamba and indexer-ring group ids.
+
+    Raises:
+        ValueError: if a group has another type, a ring declares no way to
+            resume inside its open group, or a kind is missing.
+
+    """
+    from vllm.v1.core.single_type_kv_cache_manager import (
+        CircularBufferManager,
+        FullAttentionManager,
+        MambaManager,
+    )
+
+    pages: list[int] = []
+    states: list[int] = []
+    rings: list[int] = []
+    for group_id, manager in enumerate(coordinator.single_type_managers):
+        if type(manager) is FullAttentionManager:
+            pages.append(group_id)
+        elif type(manager) is MambaManager:
+            states.append(group_id)
+        elif type(manager) is CircularBufferManager:
+            raise ValueError(
+                "indexer-ring groups are not supported by this experimental "
+                "port of #66881 (CircularBufferSpec was removed upstream)"
+            )
+            spec = manager.kv_cache_spec
+            assert isinstance(spec, CircularBufferSpec)
+            if spec.resume_catchup is None:
+                raise ValueError(
+                    "mamba_frontier_checkpoint needs every indexer ring to "
+                    f"declare resume_catchup; group {group_id} does not"
+                )
+            rings.append(group_id)
+        else:
+            raise ValueError(
+                "mamba_frontier_checkpoint supports full-attention, Mamba and "
+                f"indexer-ring groups only; group {group_id} is "
+                f"{type(manager).__name__}"
+            )
+    if not pages or not states:
+        raise ValueError(
+            "mamba_frontier_checkpoint needs a full-attention and a Mamba group"
+        )
+    return pages, states, rings
+
+
+def check_frontier_checkpoint_config(
+    vllm_config: "VllmConfig",
+    *,
+    block_size: int,
+    enable_kv_cache_events: bool,
+) -> None:
+    """Raise unless frontier checkpoints can run with this configuration."""
+    cache = vllm_config.cache_config
+    parallel = vllm_config.parallel_config
+    threshold = vllm_config.scheduler_config.long_prefill_token_threshold
+    refusal = None
+    if not cache.enable_prefix_caching or cache.mamba_cache_mode != "align":
+        refusal = "prefix caching with mamba_cache_mode 'align'"
+    elif cache.prefix_cache_retention_interval != 0:
+        refusal = "prefix_cache_retention_interval 0"
+    elif 0 < threshold < block_size:
+        refusal = f"no long_prefill_token_threshold below the block size ({block_size})"
+    elif (
+        vllm_config.speculative_config is not None
+        or vllm_config.num_speculative_tokens > 0
+    ):
+        refusal = "no speculative decoding (num_speculative_tokens 0)"
+    elif cache.use_replayssm:
+        refusal = "no ReplaySSM"
+    elif (transfer := vllm_config.kv_transfer_config) is not None and (
+        transfer.kv_role != "kv_both"
+        # Under "fail" a request whose load failed finishes with its computed
+        # length over blocks the load did not write: no frontier may be cut
+        # there.
+        or transfer.kv_load_failure_policy != "recompute"
+    ):
+        refusal = (
+            "a KV connector, if any, with kv_role 'kv_both' and "
+            "kv_load_failure_policy 'recompute'"
+        )
+    elif enable_kv_cache_events:
+        refusal = "no KV cache events (enable_kv_cache_events)"
+    elif (
+        parallel.decode_context_parallel_size != 1
+        or parallel.prefill_context_parallel_size != 1
+    ):
+        refusal = "decode and prefill context parallel size 1"
+    if refusal is not None:
+        raise ValueError(f"mamba_frontier_checkpoint needs {refusal}")
+
+
+class HybridCheckpointManager:
+    """Keeps recurrent states resumable past the block grid and, given a
+    prefill cost model, orders evictions by GreedyDual-Size.
+
+    Args:
+        coordinator: The KV cache coordinator whose groups hold the units.
+        hash_fn: The prefix-cache hash function.
+        waiting: The scheduler's waiting requests, first to be scheduled
+            first; GreedyDual-Size eviction keeps what their hits read.
+        eviction_cost: The prefill cost model of GreedyDual-Size eviction, or
+            None to keep the block pool's LRU order.
+        eviction_leaf_last: GreedyDual-Size evicts inner units before leaves.
+        eviction_leaf_idle_s: With `eviction_leaf_last`, a leaf unused this
+            long ranks as inner.
+
+    """
+
+    def __init__(
+        self,
+        coordinator: "KVCacheCoordinator",
+        hash_fn: Callable[[Any], bytes],
+        waiting: Callable[[], Iterable["Request"]],
+        eviction_cost: PrefillCostModel | None,
+        eviction_leaf_last: bool = False,
+        eviction_leaf_idle_s: float | None = None,
+    ) -> None:
+        pages, states, rings = layout_groups(coordinator)
+        managers = coordinator.single_type_managers
+        self.pool = coordinator.block_pool
+        self.block_size = coordinator.scheduler_block_size
+        self.mamba_managers: list[MambaManager] = [
+            managers[g]  # type: ignore[misc]
+            for g in states
+        ]
+        self.mamba_groups = frozenset(states)
+        decode_rings = [
+            spec.group_size
+            for g in rings
+            if isinstance(spec := managers[g].kv_cache_spec, CircularBufferSpec)
+            and spec.resume_catchup == "decode"
+        ]
+        # A request resumed inside an open indexer group of this many tokens
+        # takes one token per step until the group closes.
+        self.catchup_pool_size = math.lcm(1, *decode_rings)
+        self.graph = CheckpointGraph(self.block_size)
+        self.frontiers = FrontierIndex(coordinator, hash_fn, pages, states, rings)
+        self.eviction: GreedyDualSizeEviction | None = None
+        if eviction_cost is not None:
+            self.eviction = GreedyDualSizeEviction(
+                coordinator,
+                self.graph,
+                self.frontiers,
+                eviction_cost,
+                waiting,
+                leaf_last=eviction_leaf_last,
+                leaf_idle_s=eviction_leaf_idle_s,
+            )
+            # Blocks of a dropped frontier are reused before any cached block.
+            self.frontiers.reclaim = True
+        # Request -> the unit its latest lookup resumes it at, until admitted.
+        self._resume: dict[str, BlockHash] = {}
+        # Request -> units its admissions already counted as hits.
+        self._touched: dict[str, set[BlockHash]] = {}
+        # Requests resumed at a frontier inside an open indexer group, until it
+        # closes.
+        self._catching_up: set[str] = set()
+        self.num_scratch_skipped = 0
+        self.num_scratch_dropped = 0
+        self.pool.key_removal_listener = self.keys_removed
+        self.pool.eviction_policy = self.eviction
+        for manager in self.mamba_managers:
+            manager.state_cached_listener = self.state_cached
+            manager.track_unwritten_blocks = True
+
+    # Units.
+    def complete(self, key: BlockHash) -> bool:
+        cached = self.pool.cached_block_hash_to_block
+        return all(
+            cached.get_one_block(
+                make_block_hash_with_group_id(key, m.kv_cache_group_id)
+            )
+            is not None
+            for m in self.mamba_managers
+        )
+
+    def held(self, key: BlockHash) -> bool:
+        cached = self.pool.cached_block_hash_to_block
+        return any(
+            block.ref_cnt
+            for m in self.mamba_managers
+            for block in cached.get_all_blocks(
+                make_block_hash_with_group_id(key, m.kv_cache_group_id)
+            )
+        )
+
+    def state_cached(
+        self, key: BlockHash, num_tokens: int, request: "Request | None"
+    ) -> None:
+        """A Mamba group cached `key`; the graph takes it once every group
+        has."""
+        if self.complete(key):
+            self.graph.inserted(key, num_tokens)
+        if self.eviction is not None and request is not None:
+            self.eviction.record(key, num_tokens, request)
+
+    def keys_removed(self, keys: list[BlockHashWithGroupId]) -> None:
+        """The block pool dropped `keys`. A unit no longer cached in some
+        Mamba group cannot be hit."""
+        self.frontiers.removed(keys)
+        cached = self.pool.cached_block_hash_to_block
+        for grouped in keys:
+            if get_group_id(grouped) not in self.mamba_groups:
+                continue
+            key = get_block_hash(grouped)
+            if key in self.graph.units and cached.get_one_block(grouped) is None:
+                self.graph.removed(key)
+        if self.eviction is not None:
+            self.eviction.keys_removed(keys)
+
+    def release(self, key: BlockHash) -> None:
+        """Release a unit by a persistence rule: its keys go in every group.
+        Under GreedyDual-Size a block-boundary unit stays cached, no longer a
+        session leaf; the eviction order decides when it goes."""
+        unit = self.graph.units.get(key)
+        if self.eviction is not None and unit is not None and not unit.frontier:
+            self.graph.leaves.discard(key)
+            return
+        self.graph.removed(key)
+        if self.frontiers.drop(key):
+            return
+        cached = self.pool.cached_block_hash_to_block
+        for manager in self.mamba_managers:
+            grouped = make_block_hash_with_group_id(key, manager.kv_cache_group_id)
+            while (block := cached.get_one_block(grouped)) is not None:
+                if block.ref_cnt or not self.pool._maybe_evict_cached_block(block):
+                    break
+                self.frontiers.to_front(block)
+
+    # Scheduler hooks.
+    def begin_step(self) -> None:
+        if self.eviction is not None:
+            self.eviction.new_step()
+
+    def extend_hit(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+    ) -> tuple[HitBlocks, int]:
+        return self.frontiers.extend(request, blocks, hit, max_length)
+
+    def frontier_hit_tokens(self, request: "Request", num_hits: int) -> int:
+        """The tokens past the block-aligned hit that a frontier serves the
+        request if it is admitted `num_hits` tokens in, else 0."""
+        return self.frontiers.hit_tokens(request.request_id, num_hits)
+
+    def admitted(
+        self,
+        request: "Request",
+        num_computed_tokens: int,
+        blocks: "KVCacheBlocks",
+        num_external_tokens: int,
+    ) -> None:
+        """The request's lookup resumes it at `num_computed_tokens`, the
+        last `num_external_tokens` of which a KV connector loads; it is
+        admitted once `allocated` follows."""
+        resume: BlockHash | None = None
+        if num_external_tokens:
+            # It resumes at the state the load ends with, cached under the
+            # request's own hash at that hash unit, not at its last local
+            # block.
+            num_units, rest = divmod(num_computed_tokens, self.pool.hash_block_size)
+            if not rest and 0 < num_units <= len(request.block_hashes):
+                resume = request.block_hashes[num_units - 1]
+        else:
+            for group in blocks.blocks:
+                if group and (block_hash := group[-1].block_hash) is not None:
+                    resume = get_block_hash(block_hash)
+                    break
+        frontier = self.frontiers.resumed_at(request.request_id, num_computed_tokens)
+        resume = frontier or resume
+        if resume is None:
+            self._resume.pop(request.request_id, None)
+        else:
+            self._resume[request.request_id] = resume
+        self.graph.admitted(request.request_id, resume)
+
+    def catching_up(self, request_id: str, start: int) -> bool:
+        """Whether the request resumed at a frontier inside an indexer group
+        that is still open at `start`: it then takes one token per step,
+        through the decode path, until the group closes."""
+        if not start % self.catchup_pool_size:
+            self._catching_up.discard(request_id)
+            return False
+        return request_id in self._catching_up or bool(
+            self.frontiers.hit_tokens(request_id, start)
+        )
+
+    def allocated(self, request: "Request", num_hits: int) -> None:
+        """The request got its blocks `num_hits` tokens in: each unit it
+        resumes at counts one hit per request, however often a refused
+        allocation repeats the lookup."""
+        if (
+            self.frontiers.hit_tokens(request.request_id, num_hits)
+            and num_hits % self.catchup_pool_size
+        ):
+            self._catching_up.add(request.request_id)
+        else:
+            self._catching_up.discard(request.request_id)
+        self.frontiers.admitted(request, num_hits)
+        resume = self._resume.pop(request.request_id, None)
+        if resume is None:
+            return
+        counted = self._touched.setdefault(request.request_id, set())
+        if resume not in counted:
+            counted.add(resume)
+            self.graph.touched(resume)
+
+    def request_finished(self, request: "Request") -> None:
+        """Publish the request's decode-boundary state and its frontier before
+        its blocks return to the pool, and release what they replace."""
+        request_id = request.request_id
+        leaf = self._publish_decode_boundary(request)
+        self._resume.pop(request_id, None)
+        self._touched.pop(request_id, None)
+        self._catching_up.discard(request_id)
+        superseded = self.frontiers.superseded.pop(request_id, ())
+        if superseded:
+            waiting = set(self._resume.values())
+            superseded = tuple(k for k in superseded if not self._needed(k, waiting))
+        for key in superseded:
+            unit = self.graph.units.get(key)
+            if (
+                unit is not None
+                and unit.frontier
+                and key in self.graph.leaves
+                and not unit.children
+                and not unit.hits
+                and not self.held(key)
+            ):
+                self.release(key)
+        graph = self.graph
+        if leaf is not None and leaf in graph.units:
+            graph.link(request_id, leaf)
+            self._replace_leaf(request_id, leaf, boundary=True)
+            if self.eviction is not None:
+                # Cached from a scratch block, with no request: its path.
+                self.eviction.record(leaf, graph.units[leaf].num_tokens, request)
+        else:
+            leaf = None
+        frontier = self.frontiers.publish(request)
+        if frontier is not None:
+            self.state_cached(frontier, request.num_computed_tokens, request)
+            graph.link(request_id, frontier)
+            if leaf is None:
+                self._replace_leaf(request_id, frontier)
+            else:
+                graph.leaves.add(frontier)
+        graph.forget(request_id)
+        self.frontiers.forget(request_id)
+
+    def _needed(self, key: BlockHash, waiting: set[BlockHash]) -> bool:
+        """Whether a waiting request resumes at the unit `key`: its lookup did
+        (`waiting`), or under GreedyDual-Size its hit pins the unit."""
+        if key in waiting:
+            return True
+        unit = self.graph.units.get(key)
+        return (
+            unit is not None
+            and self.eviction is not None
+            and self.eviction.pinned(unit)
+        )
+
+    def _replace_leaf(
+        self, request_id: str, key: BlockHash, boundary: bool = False
+    ) -> None:
+        """`key` becomes its session's leaf; release the leaf the request
+        resumed from unless it is a branch point, held, or where a waiting
+        request resumes (`_needed`). When that was a frontier and `key` a
+        later boundary state, the boundary state the frontier extended goes
+        too, unless another continuation reached it."""
+        graph = self.graph
+        graph.leaves.add(key)
+        old = graph.resumed.get(request_id)
+        if old is None or old == key or old not in graph.leaves:
+            return
+        unit = graph.units.get(old)
+        waiting = set(self._resume.values())
+        if (
+            unit is None
+            or unit.is_branch_point
+            or self.held(old)
+            or self._needed(old, waiting)
+        ):
+            return
+        shadowed = None
+        if boundary and unit.frontier and unit.parent is not None:
+            parent = graph.units.get(unit.parent)
+            if (
+                parent is not None
+                and not parent.frontier
+                and not parent.children - {old}
+                and not parent.hits
+                and unit.parent in graph.leaves
+                and not self.held(unit.parent)
+                and not self._needed(unit.parent, waiting)
+            ):
+                shadowed = unit.parent
+        self.release(old)
+        if shadowed is not None and shadowed in graph.units:
+            self.release(shadowed)
+
+    def reset(self) -> None:
+        """The prefix cache was reset while no request held a block."""
+        self.graph.clear()
+        self._resume.clear()
+        self._touched.clear()
+        self._catching_up.clear()
+        if self.eviction is not None:
+            self.eviction.reset()
+        self.frontiers.reset()
+
+    # Decode-boundary states.
+    def decode_boundary_sources(self, request: "Request") -> list[KVCacheBlock] | None:
+        """The block holding the request's running state in every Mamba
+        group, or None unless every group has one."""
+        running = []
+        for manager in self.mamba_managers:
+            block = _running_block(manager, request.request_id)
+            if block is None:
+                return None
+            running.append(block)
